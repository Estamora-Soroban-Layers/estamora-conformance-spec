# Dependencies
node_modules/

# Build and test artifacts
dist/
coverage/
*.tsbuildinfo

# Scratch trees built by the test suite. They must live inside the working
# tree because profile validation resolves paths relative to the repository
# root, but they are never committed.
tests/.tmp*/

# Generated documentation is committed, but its scratch output is not
.docs-tmp/

# The rendered documentation site. Built by `scripts/build-docs-site.sh` and published
# by `.github/workflows/pages.yml`. Never committed: it is derived entirely from
# `docs/`, `schema/` and `profiles/`, all of which are.
site/

# Editor and OS noise
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Local environment overrides
.env
.env.local
*.local.yaml
